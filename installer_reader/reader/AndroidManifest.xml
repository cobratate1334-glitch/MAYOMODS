<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.chance.mayoinstallcheck" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <queries><package android:name="com.candywriter.bitlife" /></queries>
    <application android:label="MayoMods Install Reader"
        android:icon="@android:drawable/ic_dialog_info"
        android:allowBackup="false" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
